{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "bash": {
            "*": "ask",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "npm run dev": "allow",
            "npm run build": "allow",
            "npm run lint": "allow",
            "npm run test": "allow",
            "git add*": "ask",
            "git commit*": "ask",
            "git push*": "deny",
            "git reset --hard*": "deny",
            "git clean*": "deny"
        },
        "external_directory": "ask",
        "doom_loop": "ask"
    }
}